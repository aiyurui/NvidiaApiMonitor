# ============================================================
# 生产环境变量模板
#
# ================= Docker（推荐）=================
# **不需要这个文件。** 直接：
#     sh deploy/install.sh          # 或 docker compose up -d
# NEXTAUTH_SECRET / ENCRYPTION_KEY / 管理员密码由容器首次启动时自动生成，
# 并持久化到 data/.secrets.env（该目录跟数据库一起备份即可）。
# 想覆盖默认值，就在项目根目录建一个 .env，**只写你要改的那几行**：
#     PORT=3001
#     ADMIN_EMAIL=me@example.com
#     ADMIN_PASSWORD=你的密码
#
# ================= PM2 + Nginx =================
# 仍然需要 .env（deploy/release.sh 会校验密钥长度，缺失即拒绝发布）：
#     cp deploy/env.production.example .env && chmod 600 .env
# ⚠️ .env 已被 .gitignore 忽略，不会进版本库，需在服务器上手工创建。
# ============================================================

# ---- 数据库（SQLite）----
# 用【绝对路径】，避免 Prisma CLI 与运行时对相对路径解析基准不同，
# 导致读到 prisma/prisma/dev.db 这个幽灵文件（README 里记录过这个坑）。
#   PM2 方式：填服务器上的真实路径
#     DATABASE_URL="file:/srv/nvidia-api-monitor/data/prod.db"
#   Docker 方式：写什么都不影响 —— docker-compose.yml 会覆盖为 file:/data/prod.db
DATABASE_URL="file:/srv/nvidia-api-monitor/data/prod.db"

# ---- 时区 ----
# 「清理今日数据」「探测结论是否过期」都按服务端本地时间算。
# 不设的话 Docker 容器默认 UTC，北京时间 08:00 之前会被算成「昨天」。
# Docker 方式 compose 已设默认值，这里只对 PM2 方式有意义。
TZ="Asia/Shanghai"

# ---- NextAuth ----
# 生产环境要求 ≥32 字符（Docker 方式留空则自动生成）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或（无 node 的环境）：openssl rand -hex 32
NEXTAUTH_SECRET=""

# 让 next-auth 按请求的 Host / X-Forwarded-Host 推导访问地址。
# 有了它，NEXTAUTH_URL 就变成可选项（Docker 方式 compose 已默认开启）。
AUTH_TRUST_HOST="true"

# 对外访问地址。**通常不需要设置** —— 保持注释即可，访问地址会自动跟随。
# 只有想强制固定成某个域名时才打开它，且必须与实际访问地址完全一致。
# NEXTAUTH_URL="https://mon.example.com"

# ---- 管理员账号 ----
ADMIN_EMAIL="admin@example.com"
# 二选一（都留空则由 Docker 入口脚本随机生成并打印一次）：
#   ADMIN_PASSWORD      明文，可读性好，推荐
#   ADMIN_PASSWORD_HASH bcrypt hash（注意它含 `$`，在 .env 里要写成 `$$` 转义）
# 生成 hash：node -e "console.log(require('bcryptjs').hashSync('你的密码',10))"
ADMIN_PASSWORD=""

# ---- API Key 加密密钥（AES-256-GCM，32 字节 hex）----
# ⚠️⚠️ 迁移已有数据库时必须沿用【原来那台机器上的同一个值】，
#     否则已入库的 NVIDIA API Key 全部无法解密（表现为握手 401 / decrypt 失败）。
# Docker 方式留空则自动生成并持久化到 data/.secrets.env。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 或：openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- 任务调度与上游节流（可选，留空用默认值）----
# 任务内并发批大小；默认 = 可用 API Key 个数，设置后以此值为准
# JOB_CONCURRENCY=4
# 批次之间的等待毫秒数
# JOB_INTERVAL_MS=2000
# 连续超时多少次判定模型不可用
# CONSECUTIVE_TIMEOUT_THRESHOLD=3
# 单轮健康检查的总时长预算（毫秒）
# HEALTH_JOB_BUDGET_MS=180000

# ---- Docker 专用（PM2 方式用不到）----
# 表结构变更后是否在容器启动时自动 db push（默认 1）
# DB_PUSH_ON_START=1
# 首次启动会自动 seed（判据是 User 表为空）；=1 可强制重写管理员
# SEED_FORCE=0
# 宿主机端口（默认 3000）。改这里即可，访问地址会自动跟随，不需再改别的。
# PORT=3001

# ---- 注意：不要在这里设 NODE_ENV ----
# NODE_ENV 写进 .env 会被 Next.js 读取，导致本机 `npm run dev` 也按生产模式跑；
# 同时可能让 `npm ci` 跳过 devDependencies，使 `next build` 因缺 typescript 而失败。
# 它由 npm script / pm2 配置 / compose 各自设置，无需放在这里。
