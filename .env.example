# 本机开发用（npm run dev）的模板。
#
# 生产部署不要照抄 —— 见 deploy/env.production.example：
# Docker 方式连 .env 都不需要，密钥由容器首次启动时自动生成并持久化。
#
# 用法：cp .env.example .env 后把下面几个占位值换成你自己的。

# SQLite 路径以 prisma/ 目录为基准，canonical 库文件：prisma/dev.db
DATABASE_URL="file:./dev.db"

# 会话签名密钥（>=32 字符）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="change-me-please-32-chars-minimum!!"

# 开发时服务端与浏览器都在本机，localhost:3000 正好是正确地址。
# 生产通常不用配它：compose 已设 AUTH_TRUST_HOST，访问地址按请求自动推导。
NEXTAUTH_URL="http://localhost:3000"

# 管理员账号（npm run db:seed 使用），email 与 password 二选一或都用
ADMIN_EMAIL="admin@example.com"
# 生成：node -e "console.log(require('bcryptjs').hashSync('你的密码',10))"
ADMIN_PASSWORD_HASH=""

# API Key 加密密钥（AES-256-GCM，必须是 64 位 hex）。
# 生成：openssl rand -hex 32
# ⚠️ 换了它，库里已存的 API Key 全部解不开。
ENCRYPTION_KEY=""
